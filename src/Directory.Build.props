<Project>

  <!-- Submodule's own version (used when built standalone) -->
  <PropertyGroup>
    <AssemblyVersion>4.4.9</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- When built as part of BinSkimInternal, parent overrides version above -->
  <Import Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))"
          Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <BinSkimBuildTimestampUtc Condition="'$(BinSkimBuildTimestampUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</BinSkimBuildTimestampUtc>
    <_BinSkimYear>$(BinSkimBuildTimestampUtc.Substring(2, 2))</_BinSkimYear>
    <_BinSkimDayOfYear>$([System.DateTime]::ParseExact('$(BinSkimBuildTimestampUtc)', 'yyyyMMddHHmmss', null).DayOfYear.ToString('000'))</_BinSkimDayOfYear>
    <VersionPrefix>$([System.Version]::Parse('$(AssemblyVersion)').ToString(2)).$([System.Int32]::Parse('$(_BinSkimYear)$(_BinSkimDayOfYear)')).1</VersionPrefix>
    <VersionSuffix>$([System.Environment]::UserName)-$(BinSkimBuildTimestampUtc.Substring(8, 6))</VersionSuffix>
    <VersionSuffix Condition="'$(TF_BUILD)' == 'True'">$(BUILD_SOURCEBRANCHNAME)-$(BUILD_BUILDID)</VersionSuffix>
    <VersionSuffix Condition="'$(TF_BUILD)' == 'True' and '$(SYSTEM_PULLREQUEST_SOURCEBRANCH)' != ''">$([System.IO.Path]::GetFileName('$(SYSTEM_PULLREQUEST_SOURCEBRANCH)'))-$(BUILD_BUILDID)</VersionSuffix>
    <VersionSuffix>$([System.Text.RegularExpressions.Regex]::Replace('$(VersionSuffix)', '[^0-9A-Za-z-]', '-').ToLowerInvariant())</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <Target Name="ValidateBinSkimCalendarVersion" BeforeTargets="PrepareForBuild;Pack"
          Condition="'$(TF_BUILD)' == 'True' and '$(BinSkimOfficialVersion)' == ''">
    <Error Condition="'$(BUILD_BUILDID)' == '' or ('$(BUILD_SOURCEBRANCHNAME)' == '' and '$(SYSTEM_PULLREQUEST_SOURCEBRANCH)' == '')"
           Text="Non-release CI builds require a source branch and BUILD_BUILDID." />
  </Target>

  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\bld</ArtifactsPath>
    <AssemblySearchPath_UseCandidateAssemblyFiles>false</AssemblySearchPath_UseCandidateAssemblyFiles>
    <EnableImplicitNoneItems>false</EnableImplicitNoneItems>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Test'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\TestHelpers.cs" />
  </ItemGroup>

</Project>