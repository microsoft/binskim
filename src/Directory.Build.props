<Project>

  <!-- Submodule's own version (used when built standalone) -->
  <PropertyGroup>
    <AssemblyVersion>4.4.9</AssemblyVersion>
    <BinSkimVersion>$(AssemblyVersion).13</BinSkimVersion>
    <Version>$(BinSkimVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- When built as part of BinSkimInternal, parent overrides version above -->
  <Import Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../')))"
          Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\bld</ArtifactsPath>
    <AssemblySearchPath_UseCandidateAssemblyFiles>false</AssemblySearchPath_UseCandidateAssemblyFiles>
    <EnableImplicitNoneItems>false</EnableImplicitNoneItems>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Test'))">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Match the driver's long-path support and registration-free DIA activation in test apphosts. -->
    <ApplicationManifest>$(MSBuildThisFileDirectory)BinSkim.Driver\app.manifest</ApplicationManifest>
    <!-- Tests call the self-contained driver's APIs rather than launching its executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Test'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\TestHelpers.cs" />
  </ItemGroup>

</Project>