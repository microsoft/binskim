<Project>
  <PropertyGroup>
    <!-- Deploy dia dlls to official, published win-x64 build -->
    <DeployDia Condition="$(RuntimeIdentifier) == 'win-x64'">true</DeployDia>
    <!-- Deploy dia dll to unofficial, unpublished build, but only on Windows -->
    <DeployDia Condition="$(RuntimeIdentifier) == '' and $([MSBuild]::IsOSPlatform('Windows')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'x64'">true</DeployDia>
    <!-- But don't deploy to non-exes and non-test projects-->
    <DeployDia Condition="'$(OutputType)' != 'Exe' and !$(MSBuildProjectName.StartsWith('Test'))">false</DeployDia>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeployDia)' == 'true'">
    <!-- Per-project intermediates avoid races between projects in parallel builds. -->
    <_DiaNativeRoot>$(IntermediateOutputPath)dia\$(DiaNativePackageVersion)</_DiaNativeRoot>
    <_DiaNativePackage>$(_DiaNativeRoot)\Microsoft.VisualCpp.DIA.SDK.vsix</_DiaNativePackage>
    <_DiaNativeDll>$(_DiaNativeRoot)\msdia140.dll</_DiaNativeDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeployDia)' == 'true'">
    <!-- SDK timestamps need not increase when changing the pinned version. -->
    <None Include="$(_DiaNativeDll)" Link="msdia140.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <MsDiaLibs Include="$(MSBuildThisFileDirectory)..\refs\x64\*" />
    <MsDiaLibs Include="$(MSBuildThisFileDirectory)..\refs\msdia140.dll.manifest" />
    <MsRuntime Include="$(MSBuildThisFileDirectory)..\refs\runtime\*" />
    <None Include="@(MsDiaLibs);@(MsRuntime)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup> 

  <Target Name="PrepareNativeDia" BeforeTargets="AssignTargetPaths"
          Condition="'$(DeployDia)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <DownloadFile SourceUrl="$(DiaNativePackageUrl)" DestinationFolder="$(_DiaNativeRoot)"
                  DestinationFileName="Microsoft.VisualCpp.DIA.SDK.vsix"
                  Condition="!Exists('$(_DiaNativePackage)')" />
    <VerifyFileHash File="$(_DiaNativePackage)" Hash="$(DiaNativePackageSha256)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(_DiaNativePackage)" DestinationFolder="$(_DiaNativeRoot)\sdk" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_DiaNativeFile Include="$(_DiaNativeRoot)\sdk\Contents\*\bin\amd64\msdia140.dll" />
    </ItemGroup>
    <Error Condition="'@(_DiaNativeFile->Count())' != '1'"
           Text="The DIA SDK package must contain exactly one AMD64 msdia140.dll." />
    <VerifyFileHash File="@(_DiaNativeFile)" Hash="$(DiaNativeDllSha256)" Algorithm="SHA256" />
    <Copy SourceFiles="@(_DiaNativeFile)" DestinationFiles="$(_DiaNativeDll)" />
  </Target>

  <!-- Exclude managed TraceEvent's native and interop assets. -->
  <Target Name="ExcludeTraceEventDiaAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_RuntimeDiaItemsToExclude Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.Filename)' == 'Dia2Lib'" />
      <_CompileDiaItemsToExclude Include="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.Filename)' == 'Dia2Lib'" />
      <_NoneDiaItemsToExclude Include="@(None)" Condition="$([MSBuild]::ValueOrDefault('%(None.FullPath)', '').Contains('microsoft.diagnostics.tracing.traceevent'))" />
      <RuntimeCopyLocalItems Remove="@(_RuntimeDiaItemsToExclude)" />
      <ResolvedCompileFileDefinitions Remove="@(_CompileDiaItemsToExclude)" />
      <None Remove="@(_NoneDiaItemsToExclude)" />
    </ItemGroup>
  </Target>
</Project>