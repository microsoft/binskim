<?xml version="1.0"?>
<package >
  <metadata>
    <id>Microsoft.CodeAnalysis.BinSkim</id>
    <version>$version$</version>
    <title>Microsoft BinSkim Binary Analysis Security Tool</title>
    <authors>Microsoft</authors>
    <owners>Microsoft,TSE-SecurityTools</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>A correctness and security checker for Windows Portable Executable (PE), Linux ELF, and macOS Mach-O binaries. BinSkim scans binaries for secure compiler and linker settings and other security-relevant characteristics.</description>
    <summary>A correctness and security checker for PE, ELF, and Mach-O binaries.</summary>
    <releaseNotes>Version $version$ of BinSkim</releaseNotes>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>    
    <licenseUrl>https://github.com/microsoft/binskim/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/microsoft/binskim</projectUrl>
    <tags>binary analysis binskim binscope security pe elf macho portable executable executable linkable format sdl devops devsecops</tags>
    <iconUrl>https://go.microsoft.com/fwlink/?linkid=2008940</iconUrl>
  </metadata>
  <files>
    <file src="bld\publish\BinSkim.Driver\$configuration$_win-x64\**\*" target="tools\net9.0\win-x64"/>
    <file src="bld\publish\BinSkim.Driver\$configuration$_linux-x64\**\*" target="tools\net9.0\linux-x64"/>
    <file src="bld\publish\BinSkim.Driver\$configuration$_linux-arm64\**\*" target="tools\net9.0\linux-arm64"/>
    <file src="bld\publish\BinSkim.Driver\$configuration$_osx-x64\**\*" target="tools\net9.0\osx-x64"/>
    <file src="ReleaseHistory.md" target="tools\ReleaseHistory.md" />
    <file src="src\BinaryParsers\**\*.cs" target="src\BinaryParsers" />
    <file src="src\BinSkim.Driver\**\*.cs" target="src\BinSkim.Driver" />
    <file src="src\BinSkim.Rules\**\*.cs" target="src\BinSkim.Rules" />
    <file src="src\BinSkim.Sdk\**\*.cs" target="src\BinSkim.Sdk" />
  </files>
</package>